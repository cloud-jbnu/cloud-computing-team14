# 이 파일을 복사해 .env를 만들고 값을 채우세요.  cp .env.example .env
# .env는 절대 커밋하지 않습니다.

# AWS
AWS_REGION=us-east-1   # Learner Lab 허용 리전
AWS_PROFILE=

# DynamoDB / S3
ITEMS_TABLE=csradar-items
SUBSCRIPTIONS_TABLE=csradar-subscriptions
SEEN_TABLE=csradar-seen
RAW_BUCKET=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=   # 명령어 등록(bot/src/register.py)에 필요
DISCORD_PUBLIC_KEY=       # 개발자 포털 → General Information → Public Key (명령어 요청의 서명 검사)
DISCORD_GUILD_ID=      # 새 글을 올릴 디스코드 서버 ID (서버 이름 우클릭 → 서버 ID 복사)

# Gemini — 새 글 AI 요약 (https://aistudio.google.com 에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# GitHub 트렌딩 수집용 (선택, 요청 한도 늘리기)
GITHUB_TOKEN=
