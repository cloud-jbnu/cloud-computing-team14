# 이 파일을 복사해 .env를 만들고 값을 채우세요.  cp .env.example .env
# .env는 절대 커밋하지 않습니다.

# AWS
AWS_REGION=ap-northeast-2
AWS_PROFILE=

# DynamoDB / S3
ITEMS_TABLE=csradar-items
SUBSCRIPTIONS_TABLE=csradar-subscriptions
RAW_BUCKET=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# GitHub 트렌딩 수집용 (선택, 요청 한도 늘리기)
GITHUB_TOKEN=
